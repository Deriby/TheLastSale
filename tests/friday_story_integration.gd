extends "res://tests/everyday_integration.gd"
## Real title handoff, optional memories, checkout dialogue and night boundary.
func run() -> void:
 Preferences.frame_limit=60;Preferences.camera_distance=0;Preferences.apply();Session.new_shift()
 app=load("res://scenes/main/main.tscn").instantiate();app.process_mode=Node.PROCESS_MODE_PAUSABLE;add_child(app)
 app.interface.finish_title_launch(false);world=app.world;world.spawn_wait=999;await ticks(3)
 check(Dialogue.sequence=="friday_arrival" and Dialogue.active,"iniciar pelo menu apresenta a chegada e a relação entre os irmãos")
 check(Session.stage==0 and world.player.position.z>.6,"chegada acontece na calçada sem concluir a conversa de trabalho")
 var at:=world.player.position;var yaw:=world.player.camera_rig.yaw
 await wheel(MOUSE_BUTTON_WHEEL_DOWN,8)
 check(world.player.camera_rig.target_distance>1.5,"rodinha continua abrindo terceira pessoa durante a chegada")
 check(world.player.position.distance_to(at)<.03 and is_equal_approx(world.player.camera_rig.yaw,yaw),"chegada não teleporta o personagem nem força o enquadramento")
 await key(KEY_SPACE);check(Dialogue.active and Dialogue.queue.size()==1,"Espaço avança a conversa inicial normalmente")
 clear_dialogue();check(not world.story.begin_arrival(),"chegada é única e não toca outra vez na mesma partida")
 Session.save_shift(world.player.position);app.start_saved();world=app.world;world.spawn_wait=999;await ticks(3)
 check(world.story.done("arrival") and not Dialogue.active,"continuar preserva a chegada sem repetir a apresentação")
 check(world.player.camera_rig.target_distance>1.5,"continuar mantém a câmera escolhida pela rodinha")
 Session.greet();clear_dialogue()
 world.story.try_remark(world.player)
 check(Dialogue.sequence=="smalltalk" and not JSON.stringify(Dialogue.queue).contains("cara do outro lado"),"sem observação os irmãos conversam sobre a família, sem inventar suspeitas")
 clear_dialogue();var money:=Session.sales_cents;var receipts:=Session.receipts.size()
 world.everyday.record("observer_seen","Vi uma pessoa do outro lado da rua.")
 check(world.story.noticed("observer_seen"),"observação percebida alimenta a memória narrativa")
 world.story.try_remark(world.player)
 check(Dialogue.sequence=="friday_remark_observer_seen","conversar depois de observar a rua muda a fala dos irmãos")
 clear_dialogue();world.story.try_remark(world.player)
 check(Dialogue.sequence=="smalltalk","reação específica não se repete a cada interação")
 clear_dialogue();world.cashier_open=true
 check(not world.story.try_remark(world.player) and not Dialogue.active,"conversa opcional não interrompe um atendimento aberto")
 world.cashier_open=false
 for id in ["empty_chime","stock_steps","car_noticed"]:
  world.everyday.record(id);world.story.try_remark(world.player)
  check(Dialogue.sequence=="friday_remark_"+id,"reação própria ao acontecimento "+id)
  clear_dialogue()
 check(Session.sales_cents==money and Session.receipts.size()==receipts,"observações e conversas não alteram vendas nem dinheiro")
 var visitor:=Customer.new();visitor.identity="ClienteBone";world.sale=ShopSale.create(1)
 var order:=world.story.order_lines(visitor,"PEDIDO DE TESTE: água.")
 check(JSON.stringify(order).contains("PEDIDO DE TESTE: água.") and JSON.stringify(order).contains("Por que você quer saber?"),"cliente de boné mantém o pedido completo e provoca uma resposta desconfiada")
 check(not world.story.noticed("customer_back_door"),"montar uma fila de diálogo não registra fala ainda não ouvida")
 Dialogue.play("sale_order_test",order);Dialogue.next_line()
 check(world.story.noticed("customer_back_door") and world.story.done("door_question"),"pergunta só vira memória quando a fala é realmente exibida")
 var note_count: int=Session.campaign.experience.notes.size();clear_dialogue()
 Dialogue.play("sale_order_repeat",world.story.order_lines(visitor,"Outro pedido."));clear_dialogue()
 check(Session.campaign.experience.notes.size()==note_count,"pergunta não cria anotações duplicadas nos próximos atendimentos")
 visitor.identity="Garota1";var tired:=JSON.stringify(world.story.order_lines(visitor,"Água."))
 visitor.identity="Velha1";var mother:=JSON.stringify(world.story.order_lines(visitor,"Água."))
 visitor.identity="ClienteTrabalho";var delivery:=JSON.stringify(world.story.order_lines(visitor,"Água."))
 check(tired.contains("buzina") and mother.contains("Sua mãe") and delivery.contains("caminhão"),"clientes têm conversas próprias sem trocar seus modelos ou pedidos")
 visitor.free()
 check(JSON.stringify(world.story.familiar_lines("Bryan",world.player,0)).contains("gaveta") and JSON.stringify(world.story.familiar_lines("Bryan",world.player,1)).contains("mochila"),"Bryan tem humor de criança inquieta e reconhece visitas repetidas")
 check(JSON.stringify(world.story.familiar_lines("Zirico",world.player,0)).contains("sino"),"Zirico reage ao sino que foi percebido")
 var warning:=world.story.warning_lines()
 check(warning.size()==10 and warning.any(func(line):return str(line[1])=="Eu vi foi nos fundos. Não sei se é o mesmo."),"aviso original conserva conteúdo e distingue o relato do cliente da pessoa vista na rua")
 Session.save_shift(world.player.position);app.start_saved();world=app.world;world.spawn_wait=999;await ticks(3)
 check(world.story.done("remark_observer_seen") and world.story.noticed("customer_back_door"),"save conserva reações já ouvidas e pergunta do cliente")
 clear_dialogue();discard_customer();Session.campaign.phase="closing"
 Session.campaign.flags.till_closed=true;Session.campaign.flags.stock_checked=true;Session.campaign.flags.lights_off=true;Session.campaign.flags.reunite=true
 for actor in world.characters.values():actor.position=Vector3(3.8 if actor.identity=="Dery" else 4.4,.01,1.4);actor.reset_physics_interpolation()
 check(world.friday.activate("exit",world.player) and Dialogue.sequence=="friday_closing_hook" and not world.friday.finishing,"fechamento tem conversa tensa antes de baixar as portas")
 check(JSON.stringify(Dialogue.queue).contains("cara da rua") and world.sound.voices.any(func(voice):return voice.stream!=null and voice.stream.resource_path.contains("stock_steps")),"gancho usa o que foi percebido e um ruído físico atrás da dupla")
 await key(KEY_ESCAPE);var closing_before:=Session.world_seconds;await ticks(8)
 check(get_tree().paused and Session.campaign.phase=="closing" and is_equal_approx(Session.world_seconds,closing_before),"pausa congela o gancho sem finalizar a noite")
 await key(KEY_ESCAPE);clear_dialogue();await ticks(110)
 check(Session.campaign.phase=="complete" and app.interface.night_panel!=null,"terminar a conversa permite que as portas baixem e conclui a sexta")
 check(Rect2(Vector2.ZERO,app.interface.root.size).encloses(app.interface.night_panel.get_global_rect()),"resumo com gancho narrativo cabe na janela nativa")
 check(not str(Session.campaign.friday_story.recap).is_empty(),"relato do fechamento fica salvo para a próxima noite")
 app.interface.night_panel.find_child("NextNight",true,false).pressed.emit();world=app.world;world.spawn_wait=999;await ticks(4)
 check(world.story.noticed("observer_seen") and world.story.done("closing_hook"),"mudança de noite preserva a memória da sexta apesar do reset de eventos ambientais")
 check(world.saturday.introduce(world.player) and JSON.stringify(Dialogue.queue).contains("cara do outro lado"),"abertura de sábado retoma a experiência concreta dos irmãos")
 clear_dialogue();Session.save_shift(world.player.position);app.start_saved();world=app.world;await ticks(3)
 check(Session.campaign.phase=="saturday_routine" and world.story.done("closing_hook"),"continuar no sábado conserva narrativa e mecânicas de investigação")
 var old:=Session.snapshot_data();old.campaign.erase("friday_story");Session.write_save(old)
 check(Session.load_shift() and Session.campaign.friday_story.events is Dictionary and Session.campaign.friday_story.observations is Dictionary,"save anterior à revisão recebe campos opcionais sem perder a campanha")
 app.world.sound.stop_all();await get_tree().create_timer(.25,true,false,true).timeout;app.queue_free();await ticks(4)
 Geo.materials.clear();ProductLibrary.materials.clear();ProductLibrary.meshes.clear();CharacterModels.imported_materials.clear();CharacterModels.costume_materials.clear()
 print("FRIDAY STORY RESULT ",checks-failures.size(),"/",checks," passed; failures=",failures)
 get_tree().quit(0 if failures.is_empty() else 1)
