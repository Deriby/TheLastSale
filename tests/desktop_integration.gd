extends "res://tests/everyday_integration.gd"
func click(item: Control) -> void:
 var at:=item.get_global_rect().get_center()
 var motion:=InputEventMouseMotion.new();motion.position=at;motion.global_position=at;get_viewport().push_input(motion,true);await ticks(1)
 var event:=InputEventMouseButton.new();event.position=at;event.global_position=at;event.button_index=MOUSE_BUTTON_LEFT;event.pressed=true;get_viewport().push_input(event,true);await ticks(1)
 event=event.duplicate();event.pressed=false;get_viewport().push_input(event,true);await ticks(3)
func run() -> void:
 Preferences.camera_distance=0;Preferences.frame_limit=60;Preferences.apply();Session.new_shift();Session.advance_to_saturday()
 app=load("res://scenes/main/main.tscn").instantiate();app.process_mode=Node.PROCESS_MODE_PAUSABLE;add_child(app);app.interface.has_started=true;app.interface.set_paused(false);world=app.world;world.active=true;world.spawn_wait=999;world.saturday.introduce(world.player);clear_dialogue();world.select_player("Felps");world.player.position=CheckoutFixture.STAFF_POSITION;world.player.reset_physics_interpolation();await ticks(12);await key(KEY_C)
 var computer: SurveillancePanel=app.interface.surveillance
 check(computer!=null and world.player.input_locked and not get_tree().paused,"C abre computador real no posto de Felps e mantém as regras físicas")
 if computer==null:await finish_test();return
 await ticks(20)
 check(Rect2(Vector2.ZERO,app.interface.root.size).encloses(computer.get_global_rect()) and computer.get_global_rect().encloses(computer.app_window.get_global_rect()),"área de trabalho e janela cabem na resolução nativa")
 check(computer.get_global_rect().encloses(computer.taskbar.get_global_rect()),"barra de tarefas permanece inteira dentro da tela")
 check(computer.app_window.scale.distance_to(Vector2.ONE)<.001 and computer.app_window.modulate.a>.99,"abertura animada termina sem deixar janela reduzida ou transparente")
 check(computer.theme!=app.interface.root.theme and computer.theme.default_font!=null,"terminal recebe tipografia e tema próprios sem modificar o HUD")
 print("DESKTOP LAYOUT root=",computer.get_global_rect()," app=",computer.app_window.get_global_rect()," minimum=",computer.app_window.get_combined_minimum_size()," taskbar=",computer.taskbar.get_global_rect())
 var feed_id:=computer.feed.get_instance_id();var lens:=computer.camera.get_instance_id()
 await click(computer.find_child("Camera2",true,false))
 check(computer.channel==2 and computer.camera.get_instance_id()==lens and computer.feed.get_instance_id()==feed_id,"clique no canal troca a imagem reutilizando câmera e viewport")
 await ticks(14)
 check(not computer.synchronization.visible and computer.osd.text.contains("CAM 03"),"sincronização termina com identificação correta do canal")
 await click(computer.find_child("EventsPage",true,false))
 check(computer.page==1 and computer.feed.render_target_update_mode==SubViewport.UPDATE_DISABLED and computer.archive.text.contains("SEM REPRODUÇÃO DE VÍDEO"),"aba de registros distingue texto do vídeo e para a câmera")
 await click(computer.find_child("MinimizeWindow",true,false))
 check(computer.minimized and not computer.app_window.visible and computer.feed.render_target_update_mode==SubViewport.UPDATE_DISABLED and world.everyday.watched_camera==null,"minimizar revela desktop sem câmera observando por trás")
 await click(computer.find_child("StartMenuButton",true,false))
 check(computer.start_menu.visible,"botão Iniciar abre o menu local")
 await click(computer.find_child("StartShortcut1",true,false));await ticks(15)
 check(not computer.minimized and computer.page==0 and not computer.start_menu.visible and world.everyday.watched_camera==computer.camera,"atalho do menu restaura o monitor ao vivo")
 var original:=computer.app_window.size;await click(computer.find_child("MaximizeWindow",true,false))
 check(computer.maximized and computer.app_window.size.x>original.x and computer.get_global_rect().encloses(computer.app_window.get_global_rect()),"maximizar amplia a janela e mantém controles dentro da tela")
 await click(computer.find_child("MaximizeWindow",true,false))
 check(not computer.maximized and computer.app_window.size.is_equal_approx(original),"restaurar devolve o tamanho original")
 var bar: Control=computer.find_child("ApplicationTitleBar",true,false);var from:=bar.get_global_rect().position+Vector2(150,15);var before:=computer.app_window.position
 var press:=InputEventMouseButton.new();press.position=from;press.global_position=from;press.button_index=MOUSE_BUTTON_LEFT;press.pressed=true;get_viewport().push_input(press,true);await ticks(1)
 var drag:=InputEventMouseMotion.new();drag.position=from+Vector2(-35,8);drag.global_position=drag.position;drag.relative=Vector2(-35,8);drag.button_mask=MOUSE_BUTTON_MASK_LEFT;get_viewport().push_input(drag,true);await ticks(1)
 press=press.duplicate();press.pressed=false;press.position=drag.position;press.global_position=drag.position;get_viewport().push_input(press,true);await ticks(2)
 check(computer.app_window.position.distance_to(before)>10 and computer.get_global_rect().encloses(computer.app_window.get_global_rect()),"arrastar a barra azul move a janela sem perder os controles")
 computer.show_document("Ajuda","Janela de ajuda da estação.");await ticks(3)
 check(computer.document_panel.visible and world.everyday.watched_camera==null and computer.feed.render_target_update_mode==SubViewport.UPDATE_DISABLED,"documento sobre a imagem suspende observação do CCTV")
 await key(KEY_ESCAPE)
 check(app.interface.surveillance==computer and not computer.document_panel.visible and world.everyday.watched_camera==computer.camera,"Esc fecha primeiro o documento e devolve a imagem ao vivo")
 computer.minimize_app();await click(computer.find_child("DesktopShortcut1",true,false));await ticks(15)
 check(not computer.minimized and computer.page==1,"ícone Registros restaura a aplicação na página correspondente")
 var clues: Dictionary=Session.campaign.clues.duplicate(true);await key(KEY_C)
 check(app.interface.surveillance==null and not world.surveillance_open and not world.player.input_locked and app.viewport.render_target_update_mode==SubViewport.UPDATE_ALWAYS,"C sai da área de trabalho e devolve câmera, entrada e renderização")
 check(Session.campaign.clues==clues,"navegar pelas novas janelas não inventa pistas")
 Session.advance_to_sunday();app.build_world();world=app.world;world.active=true;world.spawn_wait=999;world.sunday.introduce(world.player);clear_dialogue();world.select_player("Felps");world.player.position=CheckoutFixture.STAFF_POSITION;world.player.reset_physics_interpolation();await ticks(10);await key(KEY_C)
 var desk: SundayDesk=app.interface.sunday_desk
 check(desk!=null and desk.find_child("RecoverRecording",true,false).disabled and desk.find_child("OpenDocument",true,false).disabled,"computador de domingo exige entregar o módulo para abrir seus arquivos")
 if desk==null:await finish_test();return
 await ticks(18)
 check(desk.get_global_rect().encloses(desk.app_window.get_global_rect()) and desk.find_children("*","SubViewport",true,false).is_empty(),"player cabe na janela e não cria outra cena 3D")
 Session.campaign.flags.module_found=true;Session.campaign.flags.module_delivered=true;desk.refresh();await click(desk.find_child("RecoverRecording",true,false));await ticks(25)
 check(desk.video.stream is VideoStreamTheora and desk.video.is_playing() and desk.elapsed>0,"Reproduzir inicia o arquivo Theora real")
 await click(desk.find_child("PauseRecording",true,false));var elapsed: float=desk.elapsed;var position: float=desk.video.stream_position;await ticks(35)
 check(desk.video.paused and is_equal_approx(desk.elapsed,elapsed) and absf(desk.video.stream_position-position)<.12,"Pausar interrompe o vídeo e o progresso da análise")
 await click(desk.find_child("MinimizeWindow",true,false));await click(desk.find_child("RunningApplication",true,false));await ticks(15)
 check(desk.video.paused,"restaurar preserva uma pausa escolhida pelo jogador")
 await click(desk.find_child("PauseRecording",true,false));await ticks(5);await click(desk.find_child("MinimizeWindow",true,false));elapsed=desk.elapsed;await ticks(20)
 check(desk.minimized and desk.video.paused and is_equal_approx(desk.elapsed,elapsed),"minimizar também pausa o arquivo que estava tocando")
 await click(desk.find_child("RunningApplication",true,false));await ticks(15)
 check(not desk.minimized and not desk.video.paused,"restaurar retoma um arquivo que estava tocando antes")
 for frame in 160:
  await ticks(1)
  if desk.watched:break
 check(desk.watched and not desk.analyze.disabled and desk.playback.value>0,"progresso acompanha o vídeo e libera análise pela regra original")
 for frame in 520:
  await ticks(1)
  if not desk.video.is_playing():break
 check(is_equal_approx(desk.playback.value,8) and desk.playback_time.text=="00:08 / 00:08","fim real do arquivo completa o progresso e mantém análise disponível")
 await click(desk.find_child("AnalyzeRecording",true,false))
 check(app.interface.sunday_desk==null and Session.campaign.phase=="sunday_prepare" and Dialogue.sequence=="sunday_reveal","analisar continua fechando terminal e acionando a revelação original")
 clear_dialogue();await key(KEY_C);desk=app.interface.sunday_desk;await ticks(18);await click(desk.find_child("OpenDocument",true,false))
 check(desk.document_panel.visible and desk.document_text.text.contains("cliente de boné"),"cadastro abre em janela própria usando informações realmente recuperadas")
 await key(KEY_ESCAPE)
 check(app.interface.sunday_desk==desk and not desk.document_panel.visible,"Esc no cadastro mantém o computador aberto")
 await click(desk.find_child("TakeProof",true,false));await ticks(28)
 check(world.sunday.state().proof=="carried" and world.sunday.state().proof_carrier=="Felps" and desk.outcome.value>.99,"copiar preserva a prova e confirma conclusão na interface")
 await click(desk.find_child("CloseComputer",true,false))
 check(app.interface.sunday_desk==null and not world.sunday.desk_open and not world.player.input_locked,"X fecha janela e devolve controle ao personagem")
 Session.save_shift(world.player.position);app.start_saved();world=app.world;await ticks(4)
 check(world.sunday.state().proof=="carried" and world.sunday.state().proof_carrier=="Felps" and app.interface.sunday_desk==null,"save conserva operação sem deixar janela ou bloqueio de entrada aberto")
 await wheel(MOUSE_BUTTON_WHEEL_DOWN,8)
 check(world.player.camera_rig.target_distance>1.5,"terceira pessoa pela rodinha continua disponível depois do computador")
 await finish_test()
func finish_test() -> void:
 clear_dialogue();get_tree().paused=false;world.sound.stop_all();await get_tree().create_timer(.25,true,false,true).timeout;app.queue_free();await ticks(5)
 Geo.materials.clear();ProductLibrary.materials.clear();ProductLibrary.meshes.clear();CharacterModels.imported_materials.clear();CharacterModels.costume_materials.clear()
 print("DESKTOP RESULT ",checks-failures.size(),"/",checks," passed; failures=",failures);get_tree().quit(0 if failures.is_empty() else 1)
