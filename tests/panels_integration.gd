extends "res://tests/desktop_integration.gd"
func control(id: String) -> Control:return app.interface.checkout.find_child(id,true,false) as Control
func run() -> void:
 Preferences.frame_limit=60;Preferences.camera_distance=0;Preferences.apply();Session.new_shift()
 app=load("res://scenes/main/main.tscn").instantiate();app.process_mode=Node.PROCESS_MODE_PAUSABLE;add_child(app);app.start_new();app.interface.has_started=true;app.interface.set_paused(false);world=app.world;world.spawn_wait=999;Session.greet();clear_dialogue();world.select_player("Felps")
 world.sale=ShopSale.create(1);world.spawn_customer(false,{"position":[-3.1,0,-2.7],"state":int(Customer.State.WAITING),"service_started":true,"identity":"Garota1","appearance":0});app.interface.open_checkout(world);await ticks(18)
 var panel: CheckoutPanel=app.interface.checkout;var item:=control("Register_water");var receipt:=panel.receipt.get_instance_id();var id:=item.get_instance_id()
 check(panel.theme!=app.interface.root.theme and panel.receipt.get_parent().theme!=panel.theme,"caixa tem acabamento próprio e comprovante em papel")
 check(app.interface.modal_shade.visible and world.cashier_open and world.player.input_locked and not get_tree().paused,"caixa mantém regra de atendimento e escurece o fundo")
 check(panel.modulate.a>.99 and panel.get_global_rect().get_center().distance_to(app.interface.root.size*.5)<2,"entrada animada termina no centro com opacidade completa")
 await click(item as Button);await ticks(3)
 check(world.sale.registered.get("water",0)==1 and control("Register_water").get_instance_id()==id,"clique registra produto sem reconstruir o botão")
 check(panel.receipt.get_instance_id()==receipt and get_viewport().gui_get_focus_owner()==item,"recibo e foco permanecem estáveis depois do clique")
 await click(control("Remove_water") as Button)
 check(not world.sale.registered.has("water"),"botão de correção retira unidade da compra")
 await click(control("ConfirmItems") as Button)
 check(world.sale.phase==ShopSale.Phase.REGISTER and world.sale.errors==1 and panel.status.text.contains("confere"),"compra errada continua bloqueada com mensagem visível")
 for product in ["water","water","snack_0"]:await click(control("Register_"+product) as Button)
 await click(control("ConfirmItems") as Button);await ticks(4)
 check(world.sale.phase==ShopSale.Phase.PAYMENT and control("ReceiveCash")!=null,"conferência correta avança para recebimento")
 check(panel.receipt.get_instance_id()==receipt and panel.work.modulate.a>.1,"trocar etapa conserva comprovante e anima o trabalho")
 await click(control("ReceiveCash") as Button);await ticks(5)
 var coin:=control("Coin_500");id=coin.get_instance_id();await click(coin as Button)
 check(world.sale.selected_change()==500 and control("Coin_500").get_instance_id()==id,"gaveta soma moeda e preserva o controle clicado")
 await click(control("UndoCoin") as Button);check(world.sale.selected_change()==0,"retirar última moeda continua funcionando")
 await click(control("Coin_500") as Button);await click(control("ClearChange") as Button);check(world.sale.selected_change()==0,"limpar gaveta não altera o pedido")
 await click(control("Coin_500") as Button);await click(control("ConfirmChange") as Button)
 check(world.sale.phase==ShopSale.Phase.CHANGE and panel.status.text.contains("troco"),"troco incorreto permanece na mesma etapa")
 for cents in [200,100,50]:await click(control("Coin_"+str(cents)) as Button)
 check(panel.selected.text==ShopSale.money(850) and panel.due.text==ShopSale.money(850),"valores da gaveta refletem a soma real em centavos")
 await click(control("ConfirmChange") as Button);await ticks(4)
 check(world.sale.phase==ShopSale.Phase.READY and control("DeliverPurchase")!=null,"troco correto libera entrega sem finalizar sozinho")
 await click(control("DeliverPurchase") as Button);await ticks(5)
 check(app.interface.checkout==null and Session.sales_cents==1150 and Session.receipts.size()==1 and not world.player.input_locked,"entrega conclui uma única venda e devolve controle")
 if is_instance_valid(world.customer):world.customer.queue_free()
 world.customer=null;world.sale=null;world.spawn_wait=999;world.select_player("Dery");Session.deliver("stock_1");world.player.position=Vector3(3.2,.01,-5);world.player.reset_physics_interpolation();await ticks(3)
 check(app.interface.open_journal(),"J abre nova pasta de missões pela regra original")
 await ticks(15);var notebook: FieldNotebook=app.interface.notebook;var time:=Session.world_seconds
 check(notebook.selected_page==0 and notebook.find_child("CurrentTask",true,false).text==app.interface.objective.text,"primeira aba mostra o objetivo atual completo")
 var before:=JSON.stringify(Session.campaign);var stocked:=Session.stocked.duplicate()
 await click(notebook.find_child("NotesTab",true,false) as Button);await ticks(10)
 check(notebook.selected_page==1 and notebook.pages[1].visible and not notebook.pages[0].visible,"aba Registros troca só a página visível")
 await click(notebook.find_child("ControlsTab",true,false) as Button);await ticks(10)
 check(notebook.selected_page==2 and notebook.page_label.text.contains("03"),"aba Controles atualiza índice e lembretes")
 check(JSON.stringify(Session.campaign)==before and Session.stocked==stocked and is_equal_approx(Session.world_seconds,time),"navegar no caderno não conclui missão, cria pista ou avança o mundo")
 await key(KEY_ESCAPE);await ticks(3)
 check(app.interface.notebook==null and not get_tree().paused and not app.interface.modal_shade.visible,"Esc fecha pasta e restaura cena sem camada escura presa")
 app.interface.set_paused(true);app.interface.open_settings();await ticks(15)
 var settings: SettingsPanel=app.interface.settings;var sliders: Array=settings.find_children("*","HSlider",true,false)
 sliders[0].value=.4;await ticks(2)
 var readout: Label=sliders[0].get_parent().get_child(0).get_child(1)
 check(readout.text=="40%" and is_equal_approx(Preferences.volume,.4),"configurações mostram valor real atualizado ao mover slider")
 var original_size:=get_window().size;get_window().size=Vector2i(800,600);await ticks(8)
 check(Rect2(Vector2.ZERO,app.interface.root.size).encloses(settings.get_global_rect()),"configurações permanecem inteiras na janela menor")
 await key(KEY_ESCAPE);app.interface.set_paused(false);await ticks(3);app.interface.open_journal();await ticks(10)
 check(Rect2(Vector2.ZERO,app.interface.root.size).encloses(app.interface.notebook.get_global_rect()),"pasta de missões cabe em 800×600")
 app.interface.close_journal();world.sale=ShopSale.create(1);world.spawn_customer(false,{"position":[-3.1,0,-2.7],"state":int(Customer.State.WAITING),"service_started":true,"identity":"Garota1","appearance":0});world.select_player("Felps");app.interface.open_checkout(world);await ticks(12)
 var all_inside:=true
 for button in app.interface.checkout.find_children("*","Button",true,false):all_inside=all_inside and app.interface.checkout.get_global_rect().encloses(button.get_global_rect())
 check(all_inside,"botões de produtos e fechamento não ficam recortados na janela menor")
 await key(KEY_ESCAPE);get_window().size=original_size;await ticks(6);Session.campaign.reports.friday={"customers":3,"sales_cents":14500};app.interface.show_night_summary();await ticks(15)
 check(app.interface.night_panel.theme!=app.interface.root.theme and app.interface.night_panel.find_child("NextNight",true,false)!=null,"relatório recebe papel, valores e botão da próxima noite")
 check(Rect2(Vector2.ZERO,app.interface.root.size).encloses(app.interface.night_panel.get_global_rect()),"relatório inteiro permanece no quadro")
 app.interface.night_panel.queue_free();app.interface.night_panel=null;app.interface.set_paused(false)
 Session.advance_to_sunday();app.build_world();world=app.world;world.active=false;Session.campaign.phase="campaign_complete";Session.campaign.ending={"id":"resolved","survivors":["Dery","Felps"],"proof":true};app.interface.show_campaign("ending");await ticks(4)
 var ending: CampaignPanel=app.interface.campaign_panel
 check(ending.aftermath.visible and not ending.epilogue.visible and not app.interface.modal_shade.visible,"respiro do final continua mostrando o cenário antes do relato")
 ending.find_child("ReadEpilogue",true,false).pressed.emit();await ticks(90)
 check(ending.epilogue.visible and ending.reading_scroll.scroll_vertical==0 and ending.modulate.a>.99,"relato começa pelo topo depois da animação sem pular direto ao botão final")
 await finish_test()
func finish_test() -> void:
 Dialogue.clear();get_tree().paused=false;world.sound.stop_all();await get_tree().create_timer(.25,true,false,true).timeout;app.queue_free();await ticks(6);await get_tree().create_timer(.25,true,false,true).timeout
 Geo.materials.clear();ProductLibrary.materials.clear();ProductLibrary.meshes.clear();CharacterModels.imported_materials.clear();CharacterModels.costume_materials.clear()
 print("PANELS RESULT ",checks-failures.size(),"/",checks," passed; failures=",failures);get_tree().quit(0 if failures.is_empty() else 1)
