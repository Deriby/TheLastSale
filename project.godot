; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Última Venda"
config/description="Sábado com câmeras ao vivo, investigação, decisões persistentes e fechamento cooperativo. Sexta-feira em Franca: rotina, apagão e fechamento. Campanha de três noites em desenvolvimento."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Session="*res://scripts/systems/session.gd"
Dialogue="*res://scripts/systems/dialogue.gd"
Preferences="*res://scripts/systems/preferences.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="Cenário"
3d_physics/layer_2="Personagens"
3d_physics/layer_3="Interações"

[physics]

3d/default_gravity=18.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=4
environment/defaults/default_clear_color=Color(0.025, 0.033, 0.05, 1)
